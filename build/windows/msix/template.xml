<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="sfjth.exe"
        Arguments=""
        InstallLocation="C:\Program Files\sfjth\sfjth">
    </Installer>
    <PackageInformation
        PackageName="sfjth"
        PackageDisplayName="sfjth"
        PublisherName="CN=sfjth"
        PublisherDisplayName="sfjth"
        Version="0.1.0.0"
        PackageDescription="水木社区终端风格客户端">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="cn.sfjth.client"
                Description="水木社区终端风格客户端"
                DisplayName="sfjth"
                ExecutableName="sfjth.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>sfjth</DisplayName>
            <PublisherDisplayName>sfjth</PublisherDisplayName>
            <Description>水木社区终端风格客户端</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="sfjth.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
